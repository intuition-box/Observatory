# ⚠️ ALL VITE_* VARIABLES ARE BUILD-TIME, NOT RUNTIME.
#
# Vite inlines `import.meta.env.VITE_*` into the JS bundle during `vite build`.
# This is a static site — no server process reads the environment at runtime — so
# setting these only as runtime variables does nothing.
#
# On Coolify: tick "Build Variable" on each one, and set them on the *preview*
# deployment too (previews have their own build-time scope). Then redeploy with
# the cache cleared, or the previous bundle is served unchanged.
#
# To verify a deploy picked them up, check that the bundle hash changed:
#   curl -s https://<host>/ | grep -o 'assets/index-[^"]*\.js'
#
# These values ship to every visitor in plain text. They are public client
# identifiers — never put a secret in a VITE_* variable.

# Privy — https://dashboard.privy.io
# Create an app, then copy the App ID (starts with cl…)
#
# Optional. Without it the app runs read-only: browsing, the matrix, the graph
# and the registry all work; connecting a wallet and submitting claims do not.
#
# Add your deployment origin to the Privy dashboard's allowed domains. For
# per-PR previews use a wildcard, e.g. *.ontology.intuition.box
VITE_PRIVY_APP_ID=

# Intuition GraphQL indexer (optional — overrides network switcher default)
# Mainnet: https://mainnet.intuition.sh/v1/graphql
# Testnet: https://testnet.intuition.sh/v1/graphql
# VITE_INTUITION_GRAPHQL_URL=https://mainnet.intuition.sh/v1/graphql

# Privy dashboard — add BOTH custom chains:
#
# Intuition Mainnet (1155)
#   RPC: https://rpc.intuition.systems/http
#   Explorer: https://explorer.intuition.systems
#
# Intuition Testnet (13579)
#   RPC: https://testnet.rpc.intuition.systems/http
#   Explorer: https://testnet.explorer.intuition.systems/
#
# Default chain: Intuition Mainnet (1155) recommended for new users.

# Optional extra TRUST (wei) deposited into the new triple vault on submit.
# Base triple cost is read from the MultiVault contract automatically.
# VITE_TRIPLE_DEPOSIT_WEI=1000000000000000000
